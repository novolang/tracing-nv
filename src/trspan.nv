// trspan.nv — a span, and everything hung on it.
//
// A SPAN IS A VALUE THAT IS FINISHED, NOT AN OBJECT THAT IS OPEN.  Every
// tracing library in an imperative language hands back a live handle and
// mutates it: `span.set_attribute(...)`, `span.end()`.  That shape needs
// interior mutability, which costs `[mutate]` on every call, and it
// leaves a span whose lifetime is a run-time fact nobody can check —
// the commonest tracing bug in production is a span nobody ended, and it
// shows up as a trace that is simply missing.
//
// Here `start` answers a `TrSpan` with `end_unix` at `0.0`, every
// `with_*` answers a new one, and `finish` answers the one an exporter
// takes.  `is_finished` is a predicate a caller can assert on, so "a
// span nobody ended" is a test rather than an outage, and none of it
// costs an effect.
//
// TIME IS A PARAMETER.  `start` and `finish` take the instant; reading
// the clock is `trid.now_unix` at `[time]`, once, by the caller.  A span
// that stamped itself would charge `[time]` to a `core` caller and make
// every test of a duration need a sleep.
//
// ATTRIBUTES ARE TYPED AND ORDERED.  OpenTelemetry's attribute value is
// a string, a number, a boolean or an array of one of those, and a
// library that flattened them to text loses the one thing a backend
// aggregates on.  They are a LIST rather than a map because the
// specification defines no uniqueness rule a library may enforce on a
// caller's behalf — `duplicate_keys` reports instead.
//
// NOTHING HERE PERFORMS ANYTHING.  Every row in this module is `[]`.

use trctx

// What kind of thing the span measured.
//
// The five the specification defines, and the distinction is not
// cosmetic: a backend builds its service graph from `TrClient` and
// `TrServer` pairs, and a span that called itself `TrInternal` when it
// crossed a process boundary leaves a hole in that graph that no
// attribute can fill.
pub enum TrSpanKind
    // Work inside one process; the default and the commonest.
    TrInternal
    // An outbound request, ended when the response arrives.
    TrClient
    // An inbound request, ended when the response is written.
    TrServer
    // A message put on a queue; ends when the put returns, not when
    // anybody consumes it.
    TrProducer
    // A message taken off a queue.
    TrConsumer

// One attribute's value.
//
// Four scalars and three arrays, which is exactly the specification's
// set.  There is no nested arm: a span attribute is flat by design,
// because a backend indexes on it and cannot index what it cannot
// flatten.  A caller with structure to record puts it in an event, or
// renders it and says so.
pub enum TrAttrValue
    TrvStr(v: Str)
    TrvInt(v: Int)
    TrvFloat(v: Float)
    TrvBool(v: Bool)
    TrvStrList(v: [Str])
    TrvIntList(v: [Int])
    TrvBoolList(v: [Bool])

// One attribute.
pub struct TrAttr
    key: Str
    value: TrAttrValue

// Something that happened at an instant inside a span.
//
// An event rather than a child span when there is no duration to
// measure: a cache miss, a retry, a message received.  A trace made of
// zero-length spans is unreadable and costs a backend the same as one
// made of real ones.
pub struct TrEvent
    name: Str
    // Unix epoch seconds, the caller's reading.
    at_unix: Float
    attributes: [TrAttr]

// A causal edge to a span in another trace.
//
// What a batch consumer uses: one span processing fifty messages links
// to fifty producing spans, and none of them is its parent.  Modelling
// that as a parent would make one of the fifty arbitrarily special.
pub struct TrLink
    context: TrSpanContext
    attributes: [TrAttr]

// Whether the operation the span measured succeeded.
//
// Three, and `TrUnset` is not the same as `TrOk`.  `TrUnset` is the
// default and means nobody said; `TrOk` means somebody looked and it
// was fine, which a backend treats differently — an instrumentation
// library sets `TrError` and leaves `TrOk` for the application, so that
// a service's own success criteria are not overwritten by a library
// that only knows the HTTP status.
pub enum TrStatusCode
    TrUnset
    TrOk
    TrError

// The status, and why.
//
// `description` is only meaningful on `TrError`; the specification says
// so, and a library that carried one on `TrOk` produces spans a backend
// silently drops the text from.
pub struct TrStatus
    code: TrStatusCode
    description: Str

// One measured operation.
//
// `end_unix` is `0.0` until `finish`, which is what `is_finished`
// reads.  `context` carries this span's own ids and the sampled flag;
// `parent` is `None` for a root.
pub struct TrSpan
    name: Str
    kind: TrSpanKind
    context: TrSpanContext
    parent: ?TrSpanContext
    start_unix: Float
    end_unix: Float
    attributes: [TrAttr]
    events: [TrEvent]
    links: [TrLink]
    status: TrStatus

// Begin a span.
//
// The context is built by `trid.child_context` or
// `trid.root_context` — this call does not mint ids, because minting
// them is `[rand]` and a span that did it could not be built in a test
// with fixed ids.
//
// ```novo
// use trspan
//
// fn open(c: TrSpanContext) -> TrSpan
//     trspan.start("GET /users", TrServer, c, None, 1757548800.0)
//
// fn main() [io]
//     println("a span, begun")
// ```
pub fn start(name: Str, kind: TrSpanKind, context: TrSpanContext, parent: ?TrSpanContext,
             start_unix: Float) -> TrSpan []
    TrSpan { name: name, kind: kind, context: context, parent: parent,
             start_unix: start_unix, end_unix: 0.0, attributes: [], events: [],
             links: [], status: unset_status() }

// End a span at this instant.
//
// Finishing a span that is already finished answers it unchanged rather
// than refusing: a `Result` here would put a failure path on the exit
// of every instrumented function, and the double end is a caller bug
// that `is_finished` reports without one.
//
// ```novo
// use trspan
//
// fn close(s: TrSpan) -> TrSpan
//     trspan.finish(s, 1757548800.5)
//
// fn main() [io]
//     println("a span, ended")
// ```
pub fn finish(s: TrSpan, end_unix: Float) -> TrSpan []
    // The first end wins, so a caller that ends a span on both the
    // success and the failure path reports the duration of the work
    // rather than of the reporting.
    if is_finished(s)
        return s
    TrSpan { name: s.name, kind: s.kind, context: s.context, parent: s.parent,
             start_unix: s.start_unix, end_unix: end_unix, attributes: s.attributes,
             events: s.events, links: s.links, status: s.status }

// Has this span been ended?
//
// The predicate that turns "a span nobody ended" from an outage into an
// assertion.
//
// ```novo
// use trspan
//
// fn check(s: TrSpan) -> Bool
//     trspan.is_finished(s)
//
// fn main() [io]
//     println("whether a span was ended")
// ```
pub fn is_finished(s: TrSpan) -> Bool []
    s.end_unix != 0.0

// How long the span took, in seconds, or `0.0` if it has not ended.
//
// ```novo
// use trspan
//
// fn took(s: TrSpan) -> Float
//     trspan.duration_seconds(s)
//
// fn main() [io]
//     println("a span's duration")
// ```
pub fn duration_seconds(s: TrSpan) -> Float []
    // Zero rather than an optional, so a duration is arithmetic at every
    // call site; `is_finished` is the question that separates "no time
    // passed" from "nothing was measured".
    if not is_finished(s)
        return 0.0
    s.end_unix - s.start_unix

// rebuilt is a span with new lists and a new status, which is all any
// `with_*` call changes: the identity, the instants and the parent are
// copied from the span it is given.
//
// Every list a `with_*` builds is a NEW list — `list.concat` rather than
// `list.push` — because a struct's list field is shared with every copy
// of the span, and a span that grew an event would grow it on the
// caller's copy too.
fn rebuilt(s: TrSpan, attributes: [TrAttr], events: [TrEvent], links: [TrLink],
           status: TrStatus) -> TrSpan []
    TrSpan { name: s.name, kind: s.kind, context: s.context, parent: s.parent,
             start_unix: s.start_unix, end_unix: s.end_unix, attributes: attributes,
             events: events, links: links, status: status }

// The span with one more attribute.
//
// ```novo
// use trspan
//
// fn tag(s: TrSpan) -> TrSpan
//     trspan.with_attr(s, trspan.attr_int("http.status_code", 200))
//
// fn main() [io]
//     println("a span, tagged")
// ```
pub fn with_attr(s: TrSpan, a: TrAttr) -> TrSpan []
    // Through the list form rather than beside it, so a span tagged in a
    // loop and a span tagged once take the same path.
    with_attrs(s, [a])

// The span with these attributes appended.
//
// ```novo
// use trspan
//
// fn tag(s: TrSpan, attrs: [TrAttr]) -> TrSpan
//     trspan.with_attrs(s, attrs)
//
// fn main() [io]
//     println("a span, tagged several times")
// ```
pub fn with_attrs(s: TrSpan, attrs: [TrAttr]) -> TrSpan []
    if list.len(attrs) == 0
        return s
    let merged = list.concat(s.attributes, attrs)
    rebuilt(s, merged, s.events, s.links, s.status)

// The span with one more event.
//
// ```novo
// use trspan
//
// fn note(s: TrSpan) -> TrSpan
//     trspan.with_event(s, trspan.event("cache.miss", 1757548800.2, []))
//
// fn main() [io]
//     println("a span, with something noted inside it")
// ```
pub fn with_event(s: TrSpan, e: TrEvent) -> TrSpan []
    let added = list.concat(s.events, [e])
    rebuilt(s, s.attributes, added, s.links, s.status)

// The span with one more causal link.
//
// ```novo
// use trspan
//
// fn join(s: TrSpan, l: TrLink) -> TrSpan
//     trspan.with_link(s, l)
//
// fn main() [io]
//     println("a span, linked to another trace")
// ```
pub fn with_link(s: TrSpan, l: TrLink) -> TrSpan []
    let added = list.concat(s.links, [l])
    rebuilt(s, s.attributes, s.events, added, s.status)

// The span with this status.
//
// ```novo
// use trspan
//
// fn failed(s: TrSpan) -> TrSpan
//     trspan.with_status(s, trspan.error_status("upstream timed out"))
//
// fn main() [io]
//     println("a span, marked failed")
// ```
pub fn with_status(s: TrSpan, st: TrStatus) -> TrSpan []
    rebuilt(s, s.attributes, s.events, s.links, st)

// The span with an exception recorded as the specification's event.
//
// A named call rather than prose, because the event's name and its
// three attribute keys are fixed by the specification — `exception`,
// `exception.type`, `exception.message`, `exception.stacktrace` — and a
// backend's exception view finds nothing if any of them is spelled
// differently.  Every library that writes them by hand gets one wrong
// eventually.
//
// It does NOT set the status: the specification leaves that to the
// caller, because an exception that was caught and handled is not a
// failed operation.
//
// ```novo
// use trspan
//
// fn caught(s: TrSpan) -> TrSpan
//     trspan.record_exception(s, "TimeoutError", "upstream timed out", "",
//                             1757548800.4)
//
// fn main() [io]
//     println("an exception, recorded where a backend looks for it")
// ```
pub fn record_exception(s: TrSpan, kind: Str, message: Str, stacktrace: Str,
                        at_unix: Float) -> TrSpan []
    // `exception.type` is always written, even when the caller has no
    // name for it: the key is what tells a backend this event is an
    // exception at all, and an empty one is still that fact.
    var attrs: [TrAttr] = [attr_str("exception.type", kind)]
    if message != ""
        attrs = list.push(attrs, attr_str("exception.message", message))
    // An absent stacktrace is left off rather than written empty, which
    // is the specification's own rule: an attribute carrying nothing is
    // a value a backend has to decide about, and there is no decision.
    if stacktrace != ""
        attrs = list.push(attrs, attr_str("exception.stacktrace", stacktrace))
    with_event(s, event("exception", at_unix, attrs))

// An event.
//
// ```novo
// use trspan
//
// fn main() [io]
//     println(trspan.event("cache.miss", 1757548800.2, []).name)
// ```
pub fn event(name: Str, at_unix: Float, attributes: [TrAttr]) -> TrEvent []
    TrEvent { name: name, at_unix: at_unix, attributes: attributes }

// A link to a span in another trace.
//
// ```novo
// use trspan
//
// fn to(c: TrSpanContext) -> TrLink
//     trspan.link(c, [])
//
// fn main() [io]
//     println("a causal edge to another trace")
// ```
pub fn link(context: TrSpanContext, attributes: [TrAttr]) -> TrLink []
    TrLink { context: context, attributes: attributes }

// An attribute whose value is text.
//
// ```novo
// use trspan
//
// fn main() [io]
//     println(trspan.attr_str("http.method", "GET").key)
// ```
pub fn attr_str(key: Str, v: Str) -> TrAttr []
    TrAttr { key: key, value: TrvStr(v) }

// An attribute whose value is a whole number.
//
// ```novo
// use trspan
//
// fn main() [io]
//     println(trspan.attr_int("http.status_code", 200).key)
// ```
pub fn attr_int(key: Str, v: Int) -> TrAttr []
    TrAttr { key: key, value: TrvInt(v) }

// An attribute whose value is a real number.
//
// ```novo
// use trspan
//
// fn main() [io]
//     println(trspan.attr_float("db.duration_ms", 12.5).key)
// ```
pub fn attr_float(key: Str, v: Float) -> TrAttr []
    TrAttr { key: key, value: TrvFloat(v) }

// An attribute whose value is true or false.
//
// ```novo
// use trspan
//
// fn main() [io]
//     println(trspan.attr_bool("http.request.resend", false).key)
// ```
pub fn attr_bool(key: Str, v: Bool) -> TrAttr []
    TrAttr { key: key, value: TrvBool(v) }

// The unset status, which is what a span starts with.
//
// ```novo
// use trspan
//
// fn main() [io]
//     println("${trspan.unset_status().code == TrUnset}")
// ```
pub fn unset_status() -> TrStatus []
    TrStatus { code: TrUnset, description: "" }

// The ok status, which only an application sets.
//
// ```novo
// use trspan
//
// fn main() [io]
//     println("${trspan.ok_status().code == TrOk}")
// ```
pub fn ok_status() -> TrStatus []
    // No description: the specification says the text is only meaningful
    // on an error, and a backend drops it from an `ok` — so writing one
    // would be writing something nobody will ever read.
    TrStatus { code: TrOk, description: "" }

// The error status, with the description a backend shows.
//
// ```novo
// use trspan
//
// fn main() [io]
//     println(trspan.error_status("upstream timed out").description)
// ```
pub fn error_status(description: Str) -> TrStatus []
    TrStatus { code: TrError, description: description }

// The value of the first attribute under this key, or `None`.
//
// ```novo
// use trspan
//
// fn code(s: TrSpan) -> ?TrAttrValue
//     trspan.attr_of(s, "http.status_code")
//
// fn main() [io]
//     println("an attribute, looked up")
// ```
pub fn attr_of(s: TrSpan, key: Str) -> ?TrAttrValue []
    // The FIRST match, so a duplicate key at least answers the same way
    // twice; `duplicate_keys` is how the caller finds out there was one.
    for a in s.attributes
        if a.key == key
            return Some(a.value)
    None

// Every attribute key this span carries more than once.
//
// REPORTED AND NOT DEDUPLICATED.  The specification says a duplicate
// key is undefined behaviour and leaves the choice to the
// implementation; every choice loses something, and which one is right
// depends on whether the second write was a correction or a bug.  So
// the span keeps both and this says so, which is what lets a test catch
// the instrumentation that is writing `http.method` twice.
//
// ```novo
// use trspan
//
// fn clashes(s: TrSpan) -> [Str]
//     trspan.duplicate_keys(s)
//
// fn main() [io]
//     println("the attribute keys written twice")
// ```
pub fn duplicate_keys(s: TrSpan) -> [Str] []
    var found: [Str] = []
    for i in 0..list.len(s.attributes)
        let key = s.attributes[i].key
        // An earlier occurrence rather than a later one, so the answer
        // is the key's first position and does not depend on the order
        // the span was built in.
        var earlier = false
        for j in 0..i
            if s.attributes[j].key == key
                earlier = true
        // Once per key, however many times it was written.
        var reported = false
        for f in found
            if f == key
                reported = true
        if earlier and not reported
            found = list.push(found, key)
    found

// The span kind as the word the OTLP encoding uses.
//
// ```novo
// use trspan
//
// fn main() [io]
//     println(trspan.kind_name(TrServer))
// ```
pub fn kind_name(k: TrSpanKind) -> Str []
    match k
        TrInternal => "internal"
        TrClient   => "client"
        TrServer   => "server"
        TrProducer => "producer"
        TrConsumer => "consumer"
