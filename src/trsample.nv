// trsample.nv — who decides which traces are kept, and when.
//
// A SAMPLER IS A FUNCTION IN A STRUCT, NOT A TRAIT AND NOT AN OBJECT.
// A trait cannot be generic over the value type here — SPEC § 3.6's
// bounds carry an effect argument and never a type one — so `TrSampler`
// holds a function-typed field, which is the arrangement proptest-core-nv
// and matchers-nv arrived at for the same reason.  Three of the six
// shipped samplers are named functions — a sampler with no configuration
// has nothing to carry — and three are closures over the configuration
// they were built with, which is the only shape that reaches a decision
// through a field whose call takes nothing but the sampling parameters.
// A caller writing its own sampler passes a named function
// (`TrSampler`'s field type is a plain `fn`), and the closure form is
// refused at `@tier(embedded)`, which this package does not claim.
//
// THE DECISION IS MADE ONCE, AT THE ROOT, AND CARRIED.  A sampler runs
// when a span has no parent; a span WITH a parent inherits the parent's
// sampled bit and does not ask.  That is not an optimisation, it is what
// makes a trace a trace: a sampler that ran per span would keep the
// child of a dropped parent, and a backend receiving a span whose parent
// never arrived shows a broken tree that an operator cannot distinguish
// from a crashed service.
//
// `parent_based` IS THE DEFAULT FOR EXACTLY THAT REASON, and it is the
// one sampler a service at the edge of a trust boundary should think
// twice about: honouring an upstream's sampled bit means an upstream
// that sets it on everything can make this service export everything.
// `parent_based_with_root` is the composition that keeps the tree intact
// and still bounds a root.
//
// THE DECISION IS A FUNCTION OF THE TRACE ID, NOT OF A RANDOM DRAW.
// `trace_id_ratio` hashes the trace id, so every service in a
// distributed system that runs the same ratio makes the SAME decision
// about the same trace, without coordinating — which is what makes a
// ratio sampler usable at all across services.  A random draw per
// service at ratio 0.1 over five services keeps one trace in a hundred
// thousand, complete.
//
// NOTHING HERE PERFORMS ANYTHING.  Every row in this module is `[]`.

use trctx
use trspan

// What a sampler decided.
pub enum TrDecision
    // Do not record the span at all: no attributes are computed, no
    // events are added, nothing is exported.  The cheap answer.
    TrDrop
    // Record the span but do not export it.  What a backend's local
    // views and a tail-based sampler downstream use; the sampled bit
    // stays CLEAR, so children in other processes are not exported
    // either.
    TrRecordOnly
    // Record and export.  The sampled bit is set.
    TrRecordAndSample

// A decision, with whatever the sampler wants to say about it.
//
// `attributes` are added to the span, which is how a ratio sampler
// records the ratio it used — a backend doing statistics on a sampled
// stream needs to know what it was sampled at, and reconstructing that
// from configuration nobody kept is the usual reason the numbers are
// wrong.
//
// `trace_state` replaces the context's, which is how a sampler writes
// its own vendor entry.  The empty string leaves it alone.
pub struct TrSamplingResult
    decision: TrDecision
    attributes: [TrAttr]
    trace_state: Str

// Everything a sampler is allowed to look at.
//
// A struct rather than seven parameters, because a sampler is written
// by a caller and a signature that grows a parameter breaks every one
// of them; a struct that grows a field does not.
pub struct TrSamplingParams
    // `None` for a root span, which is the case a sampler exists for.
    parent: ?TrSpanContext
    trace_id: Str
    name: Str
    kind: TrSpanKind
    // The attributes known at start.  A sampler may use them — dropping
    // health checks by `http.route` is the commonest real policy — and
    // a sampler that needs an attribute set later cannot have it,
    // which is why `TrRecordOnly` exists.
    attributes: [TrAttr]
    links: [TrLink]

// A sampler: a name and the function that decides.
//
// The name is on the value because it goes into a startup line and into
// the `sampler.type` resource attribute the specification defines; a
// backend showing "which sampler produced this" from configuration
// nobody exported is a backend guessing.
pub struct TrSampler
    name: Str
    decide: fn(TrSamplingParams) -> TrSamplingResult []

// keep_everything is `always_on`'s decision.
//
// It reads nothing, which is why it is a named function: a sampler with
// no configuration has nothing for a lambda to capture, and a name is
// what the field holds.
fn keep_everything(p: TrSamplingParams) -> TrSamplingResult []
    result(TrRecordAndSample, [], "")

// keep_nothing is `always_off`'s decision.
//
// It drops rather than recording without exporting, because a caller
// that asked for nothing to be kept should not pay for the attributes a
// record-only span would compute.
fn keep_nothing(p: TrSamplingParams) -> TrSamplingResult []
    result(TrDrop, [], "")

// hex_value is the value of a hex digit, or -1 for a byte that is not
// one — which is what lets the ratio walk take the digits and pass over
// everything else in a single traversal.
fn hex_value(b: Int) -> Int []
    if b >= '0' and b <= '9'
        return b - '0'
    if b >= 'a' and b <= 'f'
        return b - 'a' + 10
    -1

// ratio_key is the first thirteen hex digits of the trace id read as an
// integer, and it is the whole of a ratio sampler's input.
//
// THIRTEEN DIGITS IS NOT AN ARBITRARY CHOICE.  Thirteen hex digits is
// fifty-two bits, the widest hex prefix that cannot overflow a signed
// 64-bit integer, and it is far finer than any ratio a caller
// configures.  The prefix rather than the low bits, because a trace id
// is uniform across its length and reading it from the front is what
// every other reader of one does.
//
// A non-hex byte is skipped rather than folded in, so an id that is not
// what the specification says is still answered the same way twice.
fn ratio_key(trace_id: Str) -> Int []
    var key = 0
    var taken = 0
    for i in 0..str.len(trace_id)
        if taken < 13
            let v = hex_value(str.byte_at_or(trace_id, i, 0))
            if v >= 0
                key = key * 16 + v
                taken = taken + 1
    key

// ratio_threshold is `ratio` clamped to `[0.0, 1.0]` and scaled to the
// key's fifty-two bits.
//
// Clamped rather than refused, because a ratio arrives from
// configuration: a deployment that wrote `2.0` meant "keep everything",
// and one that wrote `-1.0` meant "keep nothing".  A `Result` here would
// put a startup failure on a value the operator can see is out of range.
fn ratio_threshold(ratio: Float) -> Int []
    var r = ratio
    if r < 0.0
        r = 0.0
    if r > 1.0
        r = 1.0
    // 4503599627370496 is 2^52, one past the largest key there is, so a
    // ratio of exactly 1.0 admits every id rather than all but the last.
    float.to_int(r * 4503599627370496.0)

// ratio_attribute is what a sampled span carries so that a backend doing
// statistics on a sampled stream knows what the stream was sampled at.
fn ratio_attribute(ratio: Float) -> TrAttr []
    TrAttr { key: "sampler.ratio", value: TrvFloat(ratio) }

// ratio_decision is a ratio sampler's decision, with the ratio captured
// rather than looked up.
fn ratio_decision(ratio: Float, p: TrSamplingParams) -> TrSamplingResult []
    if ratio_key(p.trace_id) >= ratio_threshold(ratio)
        return result(TrDrop, [], "")
    result(TrRecordAndSample, [ratio_attribute(ratio)], "")

// parent_verdict is the decision a parent's sampled flag implies.
//
// One function for both parent-based samplers, because inheriting is one
// rule: `trctx.is_sampled` rather than a comparison here, since the
// flag is bit 0 of a byte with seven reserved neighbours.
fn parent_verdict(parent: TrSpanContext) -> TrSamplingResult []
    if trctx.is_sampled(parent)
        return result(TrRecordAndSample, [], "")
    result(TrDrop, [], "")

// decide_parent_based is `parent_based`'s decision: a child inherits and
// a root is kept.
fn decide_parent_based(p: TrSamplingParams) -> TrSamplingResult []
    match p.parent
        Some(parent) => parent_verdict(parent)
        None         => result(TrRecordAndSample, [], "")

// asked_root is `parent_based_with_root`'s decision: the parent's answer
// when there is a parent, and the captured sampler's own when there is
// not.
fn asked_root(root: TrSampler, p: TrSamplingParams) -> TrSamplingResult []
    match p.parent
        Some(parent) => parent_verdict(parent)
        None         => decide(root, p)

// over_names is `dropping_names`' decision.  The list is consulted
// first, so a name on it costs one string comparison rather than a call
// into the sampler behind.
fn over_names(names: [Str], rest: TrSampler, p: TrSamplingParams) -> TrSamplingResult []
    if list.contains(names, p.name)
        return result(TrDrop, [], "")
    decide(rest, p)

// Keep everything.
//
// The right default for development and for a service that exports
// through a tail-based collector, and the wrong one for anything
// whose volume is a cost.
//
// ```novo
// use trsample
//
// fn main() [io]
//     println(trsample.always_on().name)
// ```
pub fn always_on() -> TrSampler []
    TrSampler { name: "always_on", decide: keep_everything }

// Keep nothing.
//
// Not the same as not tracing: spans are still created and context is
// still propagated, so a downstream service that samples on its own
// still produces a trace with this service's span ids in it as parents.
//
// ```novo
// use trsample
//
// fn main() [io]
//     println(trsample.always_off().name)
// ```
pub fn always_off() -> TrSampler []
    TrSampler { name: "always_off", decide: keep_nothing }

// Keep the fraction of traces whose id falls below a threshold.
//
// `ratio` is clamped to `[0.0, 1.0]`.  The decision is a function of the
// trace id alone, so every service running this ratio agrees about
// every trace without coordinating — which is the whole reason to use a
// ratio rather than a coin.
//
// ```novo
// use trsample
//
// fn main() [io]
//     println(trsample.trace_id_ratio(0.01).name)
// ```
pub fn trace_id_ratio(ratio: Float) -> TrSampler []
    // A lambda rather than a named function, because the ratio has to
    // reach the decision and `decide` receives the sampling parameters
    // and nothing else.  This is the shape the module header describes:
    // the field holds a function, and three of the six shipped samplers
    // are closures because three of them are configured.
    TrSampler { name: "trace_id_ratio", decide: p => ratio_decision(ratio, p) }

// Honour the parent's sampled bit, and keep every root.
//
// The specification's default, and the one that keeps a trace whole.
//
// ```novo
// use trsample
//
// fn main() [io]
//     println(trsample.parent_based().name)
// ```
pub fn parent_based() -> TrSampler []
    TrSampler { name: "parent_based", decide: decide_parent_based }

// Honour the parent's sampled bit, and ask this sampler about a root.
//
// The composition a service actually runs: a request that arrives with
// a decision keeps it, and a request that starts here is bounded.
//
// ```novo
// use trsample
//
// fn main() [io]
//     let s = trsample.parent_based_with_root(trsample.trace_id_ratio(0.01))
//     println(s.name)
// ```
pub fn parent_based_with_root(root: TrSampler) -> TrSampler []
    // The root sampler's own name is folded in, because two compositions
    // with different roots are two different policies and the startup
    // line is where an operator reads which one a process runs.
    TrSampler { name: "parent_based_with_root(${root.name})",
                decide: p => asked_root(root, p) }

// A sampler that drops spans whose name is in a list, and defers to
// another for everything else.
//
// The policy every service writes by hand: a health check and a metrics
// scrape are two spans per second per replica, they are identical, and
// they are the majority of a quiet service's trace volume.  Published
// because a caller writing it themselves has to write a named function,
// and a named function that closes over a list cannot be written.
//
// ```novo
// use trsample
//
// fn main() [io]
//     let s = trsample.dropping_names(["GET /healthz"], trsample.parent_based())
//     println(s.name)
// ```
pub fn dropping_names(names: [Str], rest: TrSampler) -> TrSampler []
    // The count rather than the names: a startup line with thirty health
    // check paths in it is a startup line nobody reads.
    TrSampler { name: "dropping_names(${list.len(names)})",
                decide: p => over_names(names, rest, p) }

// A sampler from a name and a function the caller wrote.
//
// The escape hatch, and the shape a caller's own policy takes: a named
// `fn(TrSamplingParams) -> TrSamplingResult []` and a name for the
// startup line.
//
// ```novo
// use trsample
//
// fn keep_writes(p: TrSamplingParams) -> TrSamplingResult
//     trsample.result(TrRecordAndSample, [], "")
//
// fn main() [io]
//     println(trsample.sampler("writes-only", keep_writes).name)
// ```
pub fn sampler(name: Str, decide: fn(TrSamplingParams) -> TrSamplingResult []) -> TrSampler []
    TrSampler { name: name, decide: decide }

// Run a sampler.
//
// The one call `trid.start_span` makes.
//
// ```novo
// use trsample
//
// fn ask(s: TrSampler, p: TrSamplingParams) -> TrSamplingResult
//     trsample.decide(s, p)
//
// fn main() [io]
//     println("a sampling decision")
// ```
pub fn decide(s: TrSampler, p: TrSamplingParams) -> TrSamplingResult []
    s.decide(p)

// A result.
//
// ```novo
// use trsample
//
// fn main() [io]
//     println("${trsample.result(TrDrop, [], "").decision == TrDrop}")
// ```
pub fn result(decision: TrDecision, attributes: [TrAttr], trace_state: Str) -> TrSamplingResult []
    TrSamplingResult { decision: decision, attributes: attributes, trace_state: trace_state }

// The parameters a root span presents to a sampler.
//
// ```novo
// use trsample
//
// fn main() [io]
//     let p = trsample.params(None, "4bf92f3577b34da6a3ce929d0e0e4736",
//                             "GET /users", TrServer, [], [])
//     println(p.name)
// ```
pub fn params(parent: ?TrSpanContext, trace_id: Str, name: Str, kind: TrSpanKind,
              attributes: [TrAttr], links: [TrLink]) -> TrSamplingParams []
    TrSamplingParams { parent: parent, trace_id: trace_id, name: name, kind: kind,
                       attributes: attributes, links: links }

// Would a span with this decision be exported?
//
// `TrRecordAndSample` only.  A predicate rather than a comparison,
// because `TrRecordOnly` is the arm every reimplementation of
// `decision != TrDrop` gets wrong, and the symptom is a collector
// receiving spans a tail sampler was supposed to decide about.
//
// ```novo
// use trsample
//
// fn main() [io]
//     println("${trsample.is_exported(TrRecordOnly)}")
// ```
pub fn is_exported(d: TrDecision) -> Bool []
    match d
        TrRecordAndSample => true
        TrDrop            => false
        TrRecordOnly      => false

// Would a span with this decision be built at all?
//
// `TrDrop` is the cheap answer: a caller that asks this before
// computing its attributes pays nothing for a dropped span, which is the
// difference between a ratio sampler that saves money and one that only
// saves network.
//
// ```novo
// use trsample
//
// fn main() [io]
//     println("${trsample.is_recorded(TrRecordOnly)}")
// ```
pub fn is_recorded(d: TrDecision) -> Bool []
    match d
        TrDrop            => false
        TrRecordOnly      => true
        TrRecordAndSample => true
